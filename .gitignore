## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## This .gitignore file is a combination of several standard
## .gitignore files.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Build log from Apple Generate
*.buildlog

# Visual Studio 2017+ Auto-Generated folders
.vs/
.cache/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Core
wwwroot/lib/

# Web tools
node_modules/
bower_components/

# Visual Studio Code
.vscode/

# Package folders
*.nupkg
# The packages folder can be ignored as of Visual Studio 2017,
# when PackageReference was introduced.
# If you are using NuGet's packages.config, you might want to commit the packages folder.
# packages/

# User-specific files
*.sql
*.cache

# SQLite databases
*.db
*.db-shm
*.db-wal

# Backup files
*.bak
*.tmp

# Installer files
Publish/
Setup/
*.exe
*.msi
